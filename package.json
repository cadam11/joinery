{
  "name": "joinery",
  "productName": "Joinery",
  "version": "0.5.0",
  "description": "AI-native SQL Server IDE for macOS and Windows",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:stream": "turbo run build --log-order=stream",
    "dev": "pnpm run build && concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:main\"",
    "dev:renderer": "pnpm --filter @joinery/renderer run start",
    "dev:main": "wait-on http://localhost:4200 && unset ELECTRON_RUN_AS_NODE && NODE_ENV=development pnpm --filter @joinery/main run start",
    "start": "turbo run start",
    "watch": "turbo run watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:harness:up": "node tests/scripts/ensure-ssh-key.mjs && docker compose -f tests/docker-compose.test.yml up -d --wait",
    "test:harness:down": "docker compose -f tests/docker-compose.test.yml down -v",
    "test:harness:status": "docker compose -f tests/docker-compose.test.yml ps",
    "test:full": "node tests/reporter/build-report.mjs",
    "test:dashboard": "node tests/reporter/serve.mjs",
    "pretest:e2e:react": "pnpm run build",
    "test:e2e:react": "playwright test --project=e2e-react",
    "pretest:visual:react": "pnpm run build",
    "test:visual:react": "playwright test --project=visual-react",
    "pretest:perf:react": "pnpm run build",
    "test:perf:react": "playwright test --project=perf-react",
    "predocs:shots": "pnpm run build",
    "docs:shots": "node -e \"require('node:fs').rmSync('tests/reports/.cache/docs-shots-records',{recursive:true,force:true})\" && playwright test --project=docs-shots",
    "test:e2e:react:ui": "playwright test --project=e2e-react --ui",
    "test:e2e:react:live": "JOINERY_LIVE_REPORTER_URL=http://127.0.0.1:5188/_event playwright test --project=e2e-react",
    "test:visual:react:live": "JOINERY_LIVE_REPORTER_URL=http://127.0.0.1:5188/_event playwright test --project=visual-react",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,jsx,json,md,mdx,scss,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,jsx,json,md,mdx,scss,css,html}\"",
    "typecheck": "turbo run typecheck && pnpm run typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "package": "pnpm run build && node scripts/package.js",
    "package:mac": "pnpm run build && node scripts/package.js --mac",
    "package:dmg": "pnpm run build && node scripts/package.js --mac dmg:arm64 dmg:x64",
    "package:dir": "pnpm run build && node scripts/package.js --dir",
    "verify:package": "node scripts/verify-package.js && node scripts/release/asar-inventory.ts --check",
    "inventory:asar": "node scripts/release/asar-inventory.ts",
    "smoke:package": "node scripts/release/smoke-packaged-app.ts",
    "prepare": "husky",
    "clean:dist": "turbo run clean && rm -rf packages/*/dist"
  },
  "main": "packages/main/dist/index.js",
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1091.0",
    "@aws-sdk/dsql-signer": "^3.1091.0",
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
    "@azure/msal-node": "^5.1.2",
    "devicon": "^2.17.0",
    "dockerode": "^4.0.2",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.1",
    "syncpack": "^12.3.2",
    "turbo": "^2.3.3",
    "typescript": "~5.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.3",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "!(packages/renderer/**)*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/renderer/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --filter @joinery/renderer exec eslint --fix"
    ],
    "*.{json,md,scss,css,html}": [
      "prettier --write"
    ]
  }
}
