{
  "name": "@joinery/preload",
  "version": "1.0.0",
  "description": "Electron preload scripts for Joinery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/index.js && tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/index.js --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@joinery/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "esbuild": "^0.23.0",
    "typescript": "~5.4.5"
  }
}
