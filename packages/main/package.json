{
  "name": "@joinery/main",
  "productName": "Joinery (dev)",
  "version": "1.0.0",
  "description": "Electron main process for Joinery",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
    "@azure/msal-node": "^5.1.2",
    "@joinery/shared": "workspace:*",
    "dockerode": "^4.0.2",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "ssh2": "^1.17.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/mssql": "^9.1.5",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "electron": "^41.0.3",
    "typescript": "~5.4.5"
  }
}
